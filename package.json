{
  "name": "solopulse",
  "version": "2.0.12",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "start": "node server.mjs",
    "start:next": "next start",
    "lint": "next lint",
    "agent": "node agent/local-agent.mjs",
    "bridge": "node bridge/bridge.mjs",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "version:bump": "node scripts/bump-version.mjs",
    "deploy": "npm run deploy:cf",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:railway": "node scripts/bump-version.mjs && npx railway up -y",
    "deploy:vercel": "npx --yes vercel@latest --prod --yes",
    "pack:export": "node scripts/pack-export.mjs"
  },
  "dependencies": {
    "next": "15.5.21",
    "qrcode": "^1.5.4",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@opennextjs/cloudflare": "^1.20.2",
    "@railway/cli": "^5.30.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.4.0"
  }
}
