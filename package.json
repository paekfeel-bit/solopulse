{
  "name": "solopulse",
  "version": "0.1.3",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "tunnel": "npx --yes cloudflared tunnel --url http://localhost:3000",
    "tunnel:miner": "npx --yes cloudflared tunnel --url http://172.30.1.99",
    "deploy:netlify": "npx --yes netlify-cli deploy --prod --build",
    "deploy:netlify:draft": "npx --yes netlify-cli deploy --build",
    "deploy:vercel": "npx --yes vercel@latest --prod --yes",
    "pack:export": "node scripts/pack-export.mjs",
    "update:netlify": "npm run build && npm run pack:export && npx --yes netlify-cli deploy --prod --build",
    "update:vercel": "npm run build && npx --yes vercel@latest --prod --yes"
  },
  "dependencies": {
    "next": "15.5.21",
    "react": "19.0.1",
    "react-dom": "19.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "netlify-cli": "^27.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
